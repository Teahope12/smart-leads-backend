# ============================================
# SMART LEADS BACKEND - ENVIRONMENT VARIABLES
# ============================================

# ------------------------
# SERVER CONFIGURATION
# ------------------------
NODE_ENV=development
PORT=5000

# ------------------------
# DATABASE CONFIGURATION
# ------------------------
# MongoDB Local
MONGODB_URI=mongodb://localhost:27017/smart_leads

# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/smart_leads

# MongoDB with authentication
# MONGODB_URI=mongodb://admin:password@localhost:27017/smart_leads?authSource=admin

# ------------------------
# JWT AUTHENTICATION
# ------------------------
# Secret key for JWT signing (use a strong key in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ------------------------
# SECURITY
# ------------------------
# Bcrypt salt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=10

# ------------------------
# CORS CONFIGURATION
# ------------------------
# Frontend URLs (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# For production with multiple origins:
# CORS_ORIGIN=https://your-frontend-domain.com,https://another-domain.com